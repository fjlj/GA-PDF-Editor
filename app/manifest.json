{
  "name": "GA PDF Editor",
  "short_name": "GA Editor",
  "description": "Lightweight local PDF editor (annotate, forms, OCR)",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "background_color": "#222222",
  "theme_color": "#00aaff",
  "icons": [
    {
      "src": "assets/icons/GAPDF-Edit_PRO192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "assets/icons/GAPDF-Edit_PRO512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    }
  ],
  "launch_handler": {
    "client_mode": "focus-existing"
  },
  "file_handlers": [
    {
      "action": "./",
      "name": "Open in GA Editor",
      "accept": {
        "application/pdf": [".pdf"],
        "application/octet-stream": [".gapdf"]
      }
    }
  ]
}
